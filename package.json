{
  "name": "sellerhub-web",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:platform": "npm run dev -w @sellerhub/platform",
    "dev:tenant": "npm run dev -w @sellerhub/tenant",
    "build": "npm run build -w @sellerhub/platform -w @sellerhub/tenant",
    "build:platform": "npm run build -w @sellerhub/platform",
    "build:tenant": "npm run build -w @sellerhub/tenant",
    "lint": "npm run lint -w @sellerhub/platform -w @sellerhub/tenant",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
